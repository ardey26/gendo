{DOMAIN} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8787 {
		# Overwrites anything the visitor sent, so the rate limit can't be dodged.
		header_up X-Real-IP {remote_host}
		# While the app restarts (a deploy), hold requests and retry instead of answering 502.
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}
